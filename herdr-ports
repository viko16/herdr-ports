#!/usr/bin/env bash
# herdr-ports - surface listening services started by each Herdr Space.
#
#   herdr-ports               show command usage
#   herdr-ports list          print the table once and exit (scripting/debug)
#   herdr-ports watch         poller: tag Spaces running >=1 TCP listener with a
#                             $ports badge and $portlist (metadata, TTL-cleared)
#   herdr-ports ensure-watch  start the watcher if it is not already running
#                             (invoked by the pane.created plugin event)
#
# The watcher autostart is wired by herdr-plugin.toml. Sidebar rows stay in
# the user's config.toml because plugins cannot inject them:
#   [ui.sidebar.spaces]
#   rows = [["state_icon", "workspace", "$ports"], ["branch", "git_status"]]
#
# Ports belong to a Space only through a live terminal shell ancestry chain.
# Cwd is display-only. Requires Python 3; lists sockets with netstat (macOS sysctl dump), ss (Linux
# netlink) or lsof as universal fallback - lsof also resolves cwds on macOS.
# Written for bash 3.2 (stock macOS): no mapfile or associative arrays.
set -u

# U+21AF lightning: monochrome, single-width, no emoji variant. Nerd Font
# glyphs (e.g. the U+F1E6 plug) are not an option: herdr silently strips
# Private Use Area characters from metadata tokens.
BADGE="${HERDR_PORTS_BADGE:-↯}"
INTERVAL="${HERDR_PORTS_INTERVAL-5}"
PROCESS_HELPER="${BASH_SOURCE[0]%/*}/ports_processes.py"

# One line per (pid, port) TCP listener: "pid<TAB>port".
# Fastest one-shot kernel dump per platform (~5ms vs ~70ms for lsof, which
# walks every fd of every process): macOS netstat reads the whole TCP pcblist
# in a single sysctl and carries a process:pid column; Linux ss asks netlink
# inet_diag. lsof remains the universal fallback.
pid_ports() (
	set -o pipefail
	local output status=0 platform
	platform=$(uname 2> /dev/null)
	if [ "$platform" = Darwin ] && command -v netstat > /dev/null 2>&1; then
		# The process:pid token is located from the right: macOS addresses put
		# a "." before the port, so a field ending in ":digits" can only be
		# process:pid - immune to process names containing spaces or dots
		output=$(netstat -anv -p tcp 2> /dev/null | awk '
			# macOS 15 uses a numeric pid column. Address headers each take
			# two words but their data takes one field, hence the -2 offset.
			$1 == "Proto" { for (i = 1; i <= NF; i++) if ($i == "pid") pidcol = i - 2; next }
			$6 == "LISTEN" {
				port = $4; sub(/.*\./, "", port)
				pid = ""
				for (i = NF; i > 0; i--) if ($i ~ /:[0-9]+$/) { pid = $i; sub(/.*:/, "", pid); break }
				if (pid == "" && pidcol > 0) pid = $pidcol
				if (port ~ /^[0-9]+$/ && pid ~ /^[0-9]+$/) print pid "\t" port
			}
		' | sort -u) || status=$?
		# macOS 27 can return success with no TCP rows. Fall back even on
		# command failure, but never accept partial output from a failed dump.
		if [ "$status" -eq 0 ] && [ -n "$output" ]; then
			printf '%s\n' "$output"
			return 0
		fi
	fi
	if [ "$platform" = Linux ] && command -v ss > /dev/null 2>&1; then
		ss -ltnpH 2> /dev/null | awk '
			{
				port = $4; sub(/.*:/, "", port)
				while (match($0, /pid=[0-9]+/)) {
					print substr($0, RSTART + 4, RLENGTH - 4) "\t" port
					$0 = substr($0, RSTART + RLENGTH)
				}
			}
		' | sort -u
	elif command -v lsof > /dev/null 2>&1; then
		# lsof uses status 1 with no output for a successful empty selection.
		status=0
		output=$(lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>&1) || status=$?
		[ "$status" -eq 1 ] && [ -z "$output" ] && return 0
		[ "$status" -le 1 ] || return "$status"
		printf '%s\n' "$output" | awk -v status="$status" '
			/^p/ { pid = substr($0, 2) }
			/^n/ { port = $0; sub(/.*:/, "", port); if (pid ~ /^[0-9]+$/ && port ~ /^[0-9]+$/) { print pid "\t" port; seen = 1 } }
			END { if (status && !seen) exit 1 }
		' | sort -u
	else
		return 1
	fi
)

# Display only: stdin "pid<TAB>..." -> "pid<TAB>cwd".
raw_pid_cwds() (
	set -o pipefail
	local pids pid cwd
	pids=$(cut -f1 | sort -un)
	[ -n "$pids" ] || return 0
	if [ -d /proc ]; then
		for pid in $pids; do
			cwd=$(readlink "/proc/$pid/cwd" 2> /dev/null) || continue
			printf '%s\t%s\n' "$pid" "$cwd"
		done
	else
		local output status=0
		output=$(lsof -a -d cwd -p "$(printf '%s\n' $pids | paste -s -d, -)" -Fpn 2> /dev/null) || status=$?
		[ "$status" -le 1 ] || return "$status"
		# A disappearing/inaccessible PID makes batch lsof exit 1 even when
		# other PIDs have valid cwds. Keep complete display records.
		printf '%s\n' "$output" | awk -v status="$status" '
			/^p/ { pid = substr($0, 2) }
			/^n/ { cwd = substr($0, 2); if (pid ~ /^[0-9]+$/ && cwd != "") { seen = 1; print pid "\t" cwd } }
			END { if (status && !seen) exit 1 }
		'
	fi
)

# The watcher and read-only list command use the same ancestry resolver.
workspace_ports() (
	set -o pipefail
	pid_ports | python3 "$PROCESS_HELPER" workspace-ports "${1:--}" "${2:-$(date +%s)}"
)

validate_watch_options() {
	case "$INTERVAL" in
		'' | 0* | *[!0-9]*) echo 'poll interval must be an integer from 1 to 3600 seconds' >&2; return 2 ;;
	esac
	[ "${#INTERVAL}" -le 4 ] && [ "$INTERVAL" -le 3600 ] || {
		echo 'poll interval must be an integer from 1 to 3600 seconds' >&2
		return 2
	}
}

watch_singleton() {
	validate_watch_options || return $?
	local self
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
	# Keep the inode: unlinking a locked file lets a new opener take a second
	# lock. Kernel ownership handles crashes and PID reuse without signalling.
	# The key is the user plus actual socket path, not the session display name.
	# Children inherit the descriptor: ownership lasts until the last closes it.
	# A running watcher has sourced these functions; updating the file or
	# reloading Herdr does not replace them. Restart that watcher to load changes.
	exec perl -MFcntl=:DEFAULT,:flock,F_SETFD -MDigest::SHA=sha256_hex -e '
		my ($script, $socket) = @ARGV;
		my $dir = "/tmp/herdr-ports-watch-$<";
		unless (-d $dir) { mkdir($dir, 0700) or do { die "mkdir $dir: $!" unless $!{EEXIST}; }; }
		my @d = lstat($dir);
		die "unsafe lock directory" unless -d _ && !-l _ && $d[4] == $< && ($d[2] & 0777) == 0700;
		my $path = "$dir/" . sha256_hex($socket) . ".lock";
		sysopen(my $lock, $path, O_RDWR | O_CREAT | O_NOFOLLOW, 0600) or die "open lock: $!";
		my @s = stat($lock);
		die "unsafe lock file" unless -f $lock && $s[4] == $< && $s[3] == 1;
		unless (flock($lock, LOCK_EX | LOCK_NB)) {
			exit 0 if $!{EWOULDBLOCK} || $!{EAGAIN};
			die "flock: $!";
		}
		fcntl($lock, F_SETFD, 0) or die "fcntl: $!";
		exec "/bin/bash", "-c", q{source "$1"; watch_loop}, "herdr-ports-watch", $script;
		die "exec watcher: $!";
	' "$self" "${HERDR_SOCKET_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock}"
}

watch_loop() {
	# The TTL is only a backstop (a missed poll must not flicker the badge, and a
	# dead watcher must still let the badge lapse). The fast path is an explicit
	# diff: any Space that lost its last listener since the previous poll gets a
	# clear immediately, so a stopped server drops its badge
	# within one INTERVAL instead of waiting out the TTL.
	# seq is epoch-based: the server keeps the last seq per source across
	# watcher restarts and silently drops posts that do not exceed it, so a
	# counter restarting at 1 would never show again.
	validate_watch_options || return $?
	local renew=$((INTERVAL * 2)) ttl=$(((INTERVAL * 3 + 10) * 1000))
	# Renew every two intervals; TTL tolerates another interval plus 10 seconds.
	# Global read failures preserve leases; failed writes retry independently.
	local ws now cur rows list oldlist previous leases='' next last known stamp cache_dir ops successes
	cache_dir=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports-watch.XXXXXX") || return 1
	# These Bash functions stay in memory. Pin the helper to the same startup
	# version so updating the plugin cannot change its protocol mid-run.
	# Start/restart only after the update finishes; new code needs a restart.
	cp "$PROCESS_HELPER" "$cache_dir/ports_processes.py" || return 1
	local PROCESS_HELPER="$cache_dir/ports_processes.py"
	trap 'exit 0' TERM INT HUP
	while :; do
		now=$(date +%s)
		if ! rows=$(workspace_ports "$cache_dir/shells.json" "$now"); then
			# Failed reads preserve leases; retry next poll, TTL is the backstop.
			sleep "$INTERVAL" || return 1
			continue
		fi

		# Build the complete write set first, then send it through one Python
		# helper invocation. Each workspace still uses its own Herdr socket
		# connection, matching the server's one-request-per-connection protocol.
		ops=''
		cur=''
		while IFS=$'\t' read -r ws list; do
			[ -n "$ws" ] || continue
			cur="$cur$ws"$'\n'
			last='' oldlist=''
			while read -r known stamp previous; do
				if [ "$known" = "$ws" ]; then last=$stamp; oldlist=$previous; break; fi
			done <<< "$leases"
			# Port changes publish on this poll, even before lease renewal.
			if [ "$list" != "$oldlist" ] || [ -z "$last" ] || [ "$now" -lt "$last" ] || [ "$((now - last))" -ge "$renew" ]; then
				ops="$ops"$'set\t'"$ws"$'\t'"$list"$'\n'
			fi
		done <<< "$rows"
		while read -r ws last oldlist; do
			[ -n "$ws" ] || continue
			case $'\n'"$cur"$'\n' in *$'\n'"$ws"$'\n'*) continue ;; esac
			ops="$ops"$'clear\t'"$ws"$'\n'
		done <<< "$leases"

		successes=''
		if [ -n "$ops" ]; then
			successes=$(python3 "$PROCESS_HELPER" metadata "$now" "$ttl" "$BADGE" <<< "$ops") || successes=''
		fi

		next=''
		while IFS=$'\t' read -r ws list; do
			[ -n "$ws" ] || continue
			last='' oldlist=''
			while read -r known stamp previous; do
				if [ "$known" = "$ws" ]; then last=$stamp; oldlist=$previous; break; fi
			done <<< "$leases"
			case $'\n'"$successes"$'\n' in
				*$'\n'"set $ws"$'\n'*) last=$now; oldlist=$list ;;
				*) [ "$list" = "$oldlist" ] || last=0 ;;
			esac
			# Also remember failed first posts: a lost response may have applied.
			# Keep the last acknowledged list on failure so changes retry.
			next="$next$ws ${last:-0} $oldlist"$'\n'
		done <<< "$rows"
		while read -r ws last oldlist; do
			[ -n "$ws" ] || continue
			case $'\n'"$cur"$'\n' in *$'\n'"$ws"$'\n'*) continue ;; esac
			case $'\n'"$successes"$'\n' in
				*$'\n'"clear $ws"$'\n'*) continue ;;
			esac
			next="$next$ws $last $oldlist"$'\n'
		done <<< "$leases"
		leases=$next
		sleep "$INTERVAL" || return 1
	done
}

# pane.created hook: spawn the watcher singleton and return immediately so the
# event never blocks herdr. $0 is resolved to an absolute path because the
# detached child must not depend on the hook's cwd surviving.
ensure_watch() {
	validate_watch_options || return $?
	local self
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
	nohup "$self" watch > /dev/null 2>&1 &
}

# "space<TAB>pid<TAB>:p1 :p2<TAB>cwd<TAB>cmd" sorted by space then first port;
# space is "-" for listeners outside any herdr workspace (sorted last)
build_rows() {
	local tmp="$1"
	pid_ports > "$tmp/ports" || return 1
	# Cwd failure affects display only, never ownership.
	raw_pid_cwds < "$tmp/ports" > "$tmp/cwds" || true
	python3 "$PROCESS_HELPER" rows - "$(date +%s)" "$tmp/cwds" < "$tmp/ports"
}

shorten() {
	local p="${1/#$HOME/\~}"
	[ ${#p} -gt 30 ] && p="...${p: -27}"
	printf '%s' "$p"
}

list_mode() {
	# not local: the EXIT trap fires after this returned, under set -u
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/herdr-ports.XXXXXX")
	trap 'rm -rf "$tmp"' EXIT
	local space pid ports cwd cmd
	build_rows "$tmp" > "$tmp/rows" || return 1
	printf '%-12s %-20s %-7s %-30s %s\n' 'SPACE' 'PORTS' 'PID' 'PATH' 'COMMAND'
	while IFS=$'\t' read -r space pid ports cwd cmd; do
		printf '%-12.12s %-20s %-7s %-30s %s\n' "$space" "$ports" "$pid" "$(shorten "$cwd")" "$cmd"
	done < "$tmp/rows"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
case "${1:-}" in
	watch) watch_singleton ;;
	ensure-watch) ensure_watch ;;
	list) list_mode ;;
	'' | -h | --help) echo "usage: herdr-ports [list|watch|ensure-watch]" ;;
	*)
		echo "usage: herdr-ports [list|watch|ensure-watch]" >&2
		exit 2
		;;
esac
fi
